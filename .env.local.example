# --- Together AI: text-only strategist ---
# Get a key at https://api.together.ai
TOGETHER_API_KEY=your_together_ai_key_here

# Optional: override the strategist model. Defaults to the free variant
# (rate-limited, no credits required). To switch to the paid Turbo variant
# after adding credits at https://api.together.ai/settings/billing, set:
# TOGETHER_STRATEGIST_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# --- Replicate: permissive image captioner (image -> text description) ---
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_token_here

# Which Replicate model to use for captioning. Qwen2-VL is permissive enough
# for suggestive content and most NSFW; less reliable for explicit material.
# For truly explicit content, search https://replicate.com for active community
# JoyCaption ports and paste the slug here.
CAPTIONER_MODEL=lucataco/qwen2-vl-7b-instruct

# --- Clerk auth (optional — without these, the app runs without sign-in) ---
# Sign up at https://clerk.com, create an application, and copy the keys below.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxx
# CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxx
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (optional — only needed if you want cloud-sync of vault metadata) ---
# Create a project at https://supabase.com, run the SQL in SETUP.md to make the
# 'posts' table, then paste these from Settings > API.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJxxx...        # server-only, NEVER expose in the client

# --- Dropbox (Phase 1: bulk import) ---
# Create a Dropbox app at https://www.dropbox.com/developers/apps
# Choose "Scoped access" -> "App folder" or "Full Dropbox" -> name it Postwise
# Under "Permissions" enable: files.metadata.read, files.content.read, account_info.read
# Under "OAuth 2" -> Redirect URIs, add: http://localhost:3000/api/dropbox/callback
# Then paste the keys here:
# DROPBOX_APP_KEY=xxxxxxxxxxxxxxxx
# DROPBOX_APP_SECRET=xxxxxxxxxxxxxxxx
# DROPBOX_REDIRECT_URI=http://localhost:3000/api/dropbox/callback
